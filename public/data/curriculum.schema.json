{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Science Atlas backwards-compatible topic inventory",
  "type": "object",
  "required": [
    "note",
    "grades",
    "boards",
    "records",
    "schema_version",
    "source_registry",
    "board_registry"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "uniqueItems": true
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "chapter",
          "topic",
          "subtopics",
          "visuals",
          "curriculum_status",
          "concept_id",
          "curriculum_mappings",
          "review_status",
          "content_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SA-[0-9]{4}$"
          },
          "subject": {
            "type": "string"
          },
          "chapter": {
            "type": "string"
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "subtopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visuals": {
            "type": "array",
            "items": {
              "enum": [
                "2D",
                "3D",
                "Watch",
                "Simulate"
              ]
            }
          },
          "curriculum_mappings": {
            "type": "array"
          },
          "concept_id": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          },
          "content_status": {
            "type": "string"
          }
        }
      }
    }
  }
}
